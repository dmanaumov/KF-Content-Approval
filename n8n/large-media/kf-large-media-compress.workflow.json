      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000,
      "notes": "Аккаунт Google КФ (OAuth). Папка клиента открыта по ссылке на редактирование — аккаунт может в неё писать. Место файл занимает у ВЛАДЕЛЬЦА файла, т.е. у аккаунта КФ."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://smm.kontentferma.com/api/automation/tasks/{{ encodeURIComponent($('В Google?').item.json.taskId) }}/media/{{ encodeURIComponent($('В Google?').item.json.mediaId) }}/full-moved",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fullUrl: 'https://drive.google.com/file/d/' + $json.id + '/view' }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "f4bd5031-e5cf-412e-926a-623a273be7b8",
      "name": "Ссылку на Google, у нас удалить",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2660,
        -40
      ],
      "credentials": {
