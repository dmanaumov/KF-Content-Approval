        "jsCode": "const r = $('Разобрать результат').item.json;\nreturn { json: { status: 'error', stage: 'preview-upload', mediaId: r.mediaId, taskId: r.taskId, taskTitle: r.taskTitle, message: String($json.error?.message || $json.error || 'preview-upload упал').slice(0, 500) } };"
      },
      "id": "8cfd3c52-3add-41d6-b7c5-ace3ede05d17",
      "name": "Ошибка заливки",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3380,
        200
      ],
      "notes": "Готовое превью остаётся в /data/kf-compress/out — следующий запуск (через ≥30 мин) возьмёт его без пересжатия."
    },
    {
      "parameters": {
        "jsCode": "const all = $input.all().map((i) => i.json);\nconst done = all.filter((x) => x.status === 'done');\nconst errors = all.filter((x) => x.status === 'error');\nconst skipped = all.filter((x) => x.status === 'skip' || x.status === 'busy');\nconst warned = done.filter((x) => x.warning);\nreturn [{ json: {\n  done: done.length,\n  errors: errors.length,\n  skipped: skipped.length,\n  details: all,\n  warnings: warned.length,\n  errorText: [...errors, ...warned.map((w) => ({ ...w, stage: 'google-move', message: w.warning }))].map((e) => `• ${e.taskTitle || e.taskId} (media ${e.mediaId}, ${e.stage || 'compress'}${e.gaveUp ? ', больше не пытаемся' : ''}): ${e.message}`).join('\\n'),\n} }];"
      },
      "id": "880a44f3-3452-49a2-904b-5f7094ed320b",
      "name": "Итог",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
