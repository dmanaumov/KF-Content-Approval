      "id": "02398e72-3ea9-4fe1-bd65-fb3d4360dccb",
      "name": "Превью готово?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1460,
        120
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Оригинал переносим в Google-папку проекта (storageUrl из настроек проекта,\n// открытая ссылка на папку) и удаляем с disk.kontentferma.\nconst r = $json;\nconst src = $('По одному').item.json;\nconst url = String(src.storageUrl || '');\nconst m = url.match(/drive\\.google\\.com\\/(?:drive\\/(?:u\\/\\d+\\/)?folders\\/|open\\?id=)([A-Za-z0-9_-]{10,})/);\nconst folderId = m ? m[1] : '';\nconst needMove = !!src.fullOnOurDisk;\nlet warning = '';\nif (needMove && !folderId) warning = url ? 'ссылка на хранилище — не папка Google Диска (' + url + '), оригинал остался на disk.kontentferma' : 'у проекта не задано хранилище — оригинал остался на disk.kontentferma';\nelse if (needMove && !r.origPath) warning = 'оригинала уже нет в рабочей папке n8n — перенос пропущен, оригинал остался на disk.kontentferma';\nreturn { json: { ...r, folderId, moveToGoogle: needMove && !!folderId && !!r.origPath, warning } };"
      },
      "id": "21191c83-fd6c-49c9-8516-5a017568b9c7",
      "name": "В Google?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
