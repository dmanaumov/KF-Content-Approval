      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Согласователь переключает «Полный размер» на Google и удаляет оригинал с disk.kontentferma."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $('В Google?').item.json;\nreturn { json: { status: 'error', stage: 'google-move', mediaId: r.mediaId, taskId: r.taskId, taskTitle: r.taskTitle, message: String($json.error?.message || $json.error || 'перенос в Google упал').slice(0, 500) } };"
      },
      "id": "339952d1-8ed6-4456-8032-a40677df0214",
      "name": "Ошибка переноса",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
