      "notes": "Без пересборки образа превью лежит в ~/.n8n-files/kf-compress/out — читается без настроек. Со своим образом — /data/kf-compress/out (прописан в Dockerfile)."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://smm.kontentferma.com/api/automation/tasks/{{ encodeURIComponent($('Разобрать результат').item.json.taskId) }}/media/{{ encodeURIComponent($('Разобрать результат').item.json.mediaId) }}/preview-upload",
        "authentication": "genericCredentialType",
