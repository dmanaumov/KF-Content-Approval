        }
      }
    },
    {
      "parameters": {
        "jsCode": "// { items:[{mediaId,taskId,fullUrl,uploadedAt,projectId,taskTitle}], count } → по item на медиа.\n// Пустая очередь → [] → выполнение просто заканчивается.\nconst seen = new Set();\nconst out = [];\nfor (const it of $input.all()) {\n  for (const m of it.json.items || []) {\n    if (!m.fullUrl || seen.has(m.mediaId)) continue;\n    seen.add(m.mediaId);\n    out.push({ json: m });\n  }\n}\nreturn out;"
      },
      "id": "498e75c9-8021-4d9e-8a6e-c258b951507a",
      "name": "Разложить очередь",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        110
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "4fd88e3c-a4c2-4950-bca7-1d27054cf999",
      "name": "По одному",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        740,
        110
      ]
    },
    {
      "parameters": {
        "executeOnce": false,
        "command": "=S=/opt/kf/kf-compress.mjs; [ -f \"$S\" ] || S=/home/node/.n8n/kf/kf-compress.mjs; KF_MB_PER_MIN=2.5 node \"$S\" --media '{{ String($json.mediaId).replace(/'/g, \"'\\\\''\") }}' --url '{{ String($json.fullUrl).replace(/'/g, \"'\\\\''\") }}'"
      },
      "id": "68557cf1-2d54-4920-9f32-866ec5764f5d",
      "name": "Сжать (ffmpeg)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        980,
        200
      ],
      "onError": "continueErrorOutput",
      "notes": "Качает оригинал, жмёт ffmpeg'ом до ≤10 МБ (видео — 2 прохода H.264, фото — JPEG), печатает одну строку JSON. Одновременно жмётся только один файл (lock), параллельный запуск получит status=busy."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('По одному').item.json;\nconst lines = String($json.stdout || '').trim().split('\\n').filter(Boolean);\nlet r;\ntry {\n  r = JSON.parse(lines[lines.length - 1]);\n} catch (e) {\n  r = { status: 'error', message: 'не разобрал вывод скрипта: ' + String($json.stdout || $json.stderr || '').slice(0, 300) };\n}\nreturn { json: { ...r, mediaId: src.mediaId, taskId: src.taskId, taskTitle: src.taskTitle, fullUrl: src.fullUrl } };"
      },
      "id": "f7115313-04fa-40b2-bbbb-5d7fe5b649de",
      "name": "Разобрать результат",
      "type": "n8n-nodes-base.code",
