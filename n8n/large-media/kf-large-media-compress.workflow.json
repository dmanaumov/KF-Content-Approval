      "id": "71df7f5c-037c-42a1-8649-67cfa9691fa4",
      "name": "Очередь pending-compression",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        110
      ],
      "credentials": {
        "httpHeaderAuth": {
