              "id": "b968d646-cfbf-4231-84bd-23bc4575cbb7",
              "leftValue": "={{ $json.moveToGoogle }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
