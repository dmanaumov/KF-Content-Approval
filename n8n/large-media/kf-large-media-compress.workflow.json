        }
      },
      "id": "9d75fd0a-0a47-4033-8702-9e44e3b848ae",
      "name": "Залить превью в согласователь",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3140,
        40
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "KF Approval API (X-API-Key)"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Кладёт превью на disk.kontentferma (<клиент>/превью), ставит его как url медиа и снимает pending_compression — карточка перестаёт показывать «Сжимаем…»."
    },
    {
      "parameters": {
        "executeOnce": false,
        "command": "=S=/opt/kf/kf-compress.mjs; [ -f \"$S\" ] || S=/home/node/.n8n/kf/kf-compress.mjs; node \"$S\" --cleanup --media '{{ String($('Разобрать результат').item.json.mediaId).replace(/'/g, \"'\\\\''\") }}'"
      },
      "id": "55c47451-7a78-4f81-8b9a-065cc9d9ac47",
      "name": "Убрать временные файлы",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        3380,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $('Разобрать результат').item.json;\nconst g = $('В Google?').item.json;\nreturn { json: { status: 'done', mediaId: r.mediaId, taskId: r.taskId, taskTitle: r.taskTitle, kind: r.kind, srcMb: +(r.srcBytes / 1048576).toFixed(1), outMb: +(r.outBytes / 1048576).toFixed(1), tookSec: r.tookSec, movedToGoogle: g.moveToGoogle, warning: g.warning } };"
      },
